# "Leave a response" form (api/contact.ts).
# Copy to .env.local for `npm run dev` / `npm run preview`, and set the same
# names in Vercel: Project → Settings → Environment Variables.
# Never commit real values. Without RESEND_API_KEY, local runs are a dry run
# (logged, nothing sent) and production returns "not set up".

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where responses are delivered. Never shown on the site or sent to browsers.
CONTACT_TO_EMAIL=

# Sender. Resend's test sender only delivers to your own Resend account's
# email; for anything else, verify your domain in Resend and use an address on it.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Optional: comma-separated origins allowed to post, e.g.
# https://devanshlamba.in,https://www.devanshlamba.in
ALLOWED_ORIGINS=

# Assistant answers worded by Gemini on the server (api/chat.js, built from
# server/chat.ts). Without a key the assistant uses its offline answers.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults: gemini-flash-latest, falling back to gemini-3.1-flash-lite when busy.
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
